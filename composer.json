{
    "name": "antares/sis",
    "description": "Antares School Information System",
    "type": "project",
    "license": "proprietary",
    "keywords": [
        "school",
        "sis",
        "education",
        "php",
        "antares"
    ],
    "require": {
        "php": "^8.2",
        "openspout/openspout": "~4.28.5"
    },
    "require-dev": {},
    "scripts": {
        "test": [
            "@composer dump-autoload --dev --optimize --strict-psr",
            "@php tests/run.php",
            "@php tests/HttpSessionIntegrationTest.php"
        ],
        "test:mariadb": "@php tests/MysqlMigrationIntegrationTest.php",
        "test:deployment": "@php tests/DeploymentInstallationIntegrationTest.php"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        },
        "files": [
            "core/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/IdentityAccessTest.php",
            "tests/EnrollmentApplicationTest.php",
            "tests/EnrollmentAdministrativeDeliveryTest.php",
            "tests/PersonDeliveryTest.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
