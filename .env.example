# Production-safe template. Replace every CHANGE_ME value before deployment.
APP_NAME="CHANGE_ME_INSTITUTION_NAME"
APP_LOGO_PATH=/institution/logo.png
APP_FAVICON_PATH=/institution/favicon.ico
APP_PRIMARY_COLOR=#0D6EFD
APP_ASSET_VERSION=1
APP_ENV=production
APP_DEBUG=false

APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DATABASE
DB_USERNAME=CHANGE_ME_DATABASE_USER
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_CHARSET=utf8mb4

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900
