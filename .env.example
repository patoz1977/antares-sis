APP_NAME="Sistema de Información Escolar"
APP_LOGO_PATH=
APP_FAVICON_PATH=
APP_PRIMARY_COLOR=#0D6EFD
APP_ASSET_VERSION=e014-p2
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antares
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900

# Required only when intentionally creating the initial administrator through AdminSeeder.
# E0041_ADMIN_INITIAL_PASSWORD must be supplied externally and must not be committed.


LOG_LEVEL=debug
